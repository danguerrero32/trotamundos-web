{
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/latido",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/latido.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    }
  ],
  "redirects": [
    {
      "source": "/menu-carta",
      "destination": "https://lostrotamundosalpujarra.com/#menu",
      "permanent": true
    },
    {
      "source": "/menu-carta/",
      "destination": "https://lostrotamundosalpujarra.com/#menu",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "https://lostrotamundosalpujarra.com/#contacto",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "https://lostrotamundosalpujarra.com/#contacto",
      "permanent": true
    },
    {
      "source": "/aviso-legal",
      "destination": "https://lostrotamundosalpujarra.com/",
      "permanent": true
    },
    {
      "source": "/aviso-legal/",
      "destination": "https://lostrotamundosalpujarra.com/",
      "permanent": true
    },
    {
      "source": "/pagina-1",
      "destination": "https://lostrotamundosalpujarra.com/",
      "permanent": true
    },
    {
      "source": "/pagina-1/",
      "destination": "https://lostrotamundosalpujarra.com/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidad",
      "destination": "https://www.lostrotamundosalpujarra.com/privacidad",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidad/",
      "destination": "https://www.lostrotamundosalpujarra.com/privacidad",
      "permanent": true
    }
  ]
}
